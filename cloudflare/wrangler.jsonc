{
  // Meridian X on Cloudflare Workers (stage 1: static site + API through the adapter).
  // Secrets (OANDA_TOKEN, CRON_SECRET, SESSION_SECRET, GH_* tokens, BLOB_READ_WRITE_TOKEN, VAPID_*,
  // EDGE_CONFIG, ...) are set with `wrangler secret put`, never in this file.
  "name": "meridianx",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // The api/ handlers resolve their packages from the repository root; point them at this folder's copies.
  "alias": {
    "@vercel/blob": "./node_modules/@vercel/blob",
    "web-push": "./node_modules/web-push",
    "acorn": "./node_modules/acorn"
  },
  // A copy of the Vercel Blob store (src/backup.mjs, every 10 min until complete, then daily). An id, not a secret.
  "kv_namespaces": [{ "binding": "BACKUP", "id": "ef06eea1b4834f3e913b3fbd82302039" }],
  // Files api/academy.js and api/bridge.js read from disk on Node, bundled as text modules (src/bundled.mjs).
  "rules": [{ "type": "Text", "globs": ["**/academy/data/*.json", "**/ml/models/index.json", "**/CouncilBridge.mq5", "**/CouncilBridge.cs"], "fallthrough": true }],
  // The site's two addresses (both already the Worker's custom domains on the account; recorded here so a deploy keeps them).
  "routes": [{ "pattern": "aureumdesk.co.uk", "custom_domain": true }, { "pattern": "www.aureumdesk.co.uk", "custom_domain": true }],
  "triggers": { "crons": ["* * * * *", "*/10 * * * *"] },
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  "workers_dev": true
}
