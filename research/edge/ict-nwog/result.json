 },
 "definition": {
  "last": 5,
  "text": "NWOG = last H1 close before a CME break containing a Saturday to the first H1 open after it; NDOG = the same for every other CME break (17:00 New York close to the 18:00 reopen); CME hours from ict/calendar.mjs; a signal is WITH-gap when its sweep candle's extreme runs into (or through) one of the 5 most recent NWOGs or 5 most recent NDOGs formed before it and not fully filled before it"
 },
