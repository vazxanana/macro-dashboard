{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p out && cp -r index.html market-structure.html gold-trading.html manifest.json sw.js icon-192.png icon-512.png assets out/",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/cdata/:path*",
      "destination": "/api/data?p=:path*"
    },
    {
      "source": "/macro-dashboard/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/gold",
      "destination": "/gold-trading.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/run?job=council",
      "schedule": "*/4 * * * *"
    },
    {
      "path": "/api/run?job=ict",
      "schedule": "4,19,34,49 * * * *"
    }
  ],
  "installCommand": "",
  "functions": {
    "api/run.js": {
      "maxDuration": 300,
      "includeFiles": "{council,ict}/**"
    },
    "api/data.js": {
      "maxDuration": 30
    }
  }
}
