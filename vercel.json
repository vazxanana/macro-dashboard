{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "sh scripts/build.sh",
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/api/mcp/:key",
      "destination": "/api/mcp?key=:key"
    },
    {
      "source": "/cdata/:path*",
      "destination": "/api/data?p=:path*"
    },
    {
      "source": "/md/bars",
      "destination": "/api/bars"
    },
    {
      "source": "/md/stream",
      "destination": "/api/stream"
    },
    {
      "source": "/macro-dashboard/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/gold",
      "destination": "/gold-trading.html"
    },
    {
      "source": "/macro-desk",
      "destination": "/macro-desk.html"
    },
    {
      "source": "/backtest",
      "destination": "/backtest.html"
    },
    {
      "source": "/academy",
      "destination": "/academy.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/macro-dashboard/assets/(.*)",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/macro-dashboard/assets/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(icon-192.png|icon-512.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(icons/.*|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/run?job=council",
      "schedule": "*/4 * * * *"
    },
    {
      "path": "/api/run?job=ict",
      "schedule": "4,19,34,49 * * * *"
    },
    {
      "path": "/api/alert-cron",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/run.js": {
      "maxDuration": 300,
      "includeFiles": "{council,ict}/**"
    },
    "api/data.js": {
      "maxDuration": 30
    },
    "api/status.js": {
      "maxDuration": 15
    },
    "api/bars.js": {
      "maxDuration": 15
    },
    "api/users.js": {
      "maxDuration": 15
    },
    "api/stream.js": {
      "maxDuration": 300
    },
    "api/og.mjs": {
      "maxDuration": 15
    },
    "api/push.js": {
      "maxDuration": 15
    },
    "api/alert-cron.js": {
      "maxDuration": 60
    },
    "api/pine.js": {
      "maxDuration": 15
    },
    "api/bridge.js": {
      "maxDuration": 15,
      "includeFiles": "{mt5/CouncilBridge.mq5,ctrader/CouncilBridge.cs}"
    },
    "api/tv-webhook.js": {
      "maxDuration": 20
    },
    "api/ctrader-link.js": {
      "maxDuration": 30
    },
    "api/profile.js": {
      "maxDuration": 15
    },
    "api/login.js": {
      "maxDuration": 15
    },
    "api/me.js": {
      "maxDuration": 15
    },
    "api/mcp.js": {
      "maxDuration": 60,
      "includeFiles": "{ict/*.mjs,council/events.mjs}"
    },
    "api/academy.js": {
      "maxDuration": 30,
      "includeFiles": "academy/data/**"
    }
  }
}
