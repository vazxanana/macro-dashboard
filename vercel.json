{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/api/mcp/:key",
      "destination": "/api/mcp?key=:key"
    },
    {
      "source": "/api/academy-mcp/:key",
      "destination": "/api/academy-mcp?key=:key"
    },
    {
      "source": "/cdata/:path*",
      "destination": "/api/data?p=:path*"
    },
    {
      "source": "/md/bars",
      "destination": "/api/bars"
    },
    {
      "source": "/md/stream",
      "destination": "/api/stream"
    },
    {
      "source": "/macro-dashboard/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/gold",
      "destination": "/gold-trading.html"
    },
    {
      "source": "/macro-desk",
      "destination": "/macro-desk.html"
    },
    {
      "source": "/macro",
      "destination": "/macro-desk.html"
    },
    {
      "source": "/macro/",
      "destination": "/macro-desk.html"
    },
    {
      "source": "/backtest",
      "destination": "/backtest.html"
    },
    {
      "source": "/equinox",
      "destination": "/equinox.html"
    },
    {
      "source": "/charts",
      "destination": "/charts.html"
    },
    {
      "source": "/farm",
      "destination": "/farm.html"
    },
    {
      "source": "/academy",
      "destination": "/academy.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/macro-dashboard/assets/(.*)",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/macro-dashboard/assets/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(icon-192.png|icon-512.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/charts.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(icons/.*|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/data.js": {
      "maxDuration": 30
    },
    "api/status.js": {
      "maxDuration": 15
    },
    "api/bars.js": {
      "maxDuration": 15
    },
    "api/users.js": {
      "maxDuration": 15
    },
    "api/stream.js": {
      "maxDuration": 300
    },
    "api/edge-analyst.js": {
      "maxDuration": 120
    },
    "api/trade-review.js": {
      "maxDuration": 120
    },
    "api/chronos-coach.js": {
      "maxDuration": 60
    },
    "api/structure-assistant.js": {
      "maxDuration": 60
    },
    "api/bridge.js": {
      "maxDuration": 15,
      "includeFiles": "{mt5/CouncilBridge.mq5,ctrader/CouncilBridge.cs}"
    },
    "api/ctrader-link.js": {
      "maxDuration": 30
    },
    "api/profile.js": {
      "maxDuration": 15
    },
    "api/mosha.js": {
      "maxDuration": 15
    },
    "api/journal.js": {
      "maxDuration": 15
    },
    "api/demo-settings.js": {
      "maxDuration": 15
    },
    "api/eqx-bridge.js": {
      "maxDuration": 15
    },
    "api/mosha-lessons.js": {
      "maxDuration": 30
    },
    "api/login.js": {
      "maxDuration": 15
    },
    "api/signup.js": {
      "maxDuration": 30
    },
    "api/me.js": {
      "maxDuration": 15
    },
    "api/passkey.js": {
      "maxDuration": 15
    },
    "api/mcp.js": {
      "maxDuration": 60,
      "includeFiles": "{ict/*.mjs,council/events.mjs}"
    },
    "api/academy.js": {
      "maxDuration": 60,
      "includeFiles": "{academy/edges.mjs,academy/data/**,ml/models/index.json,assets/academy-core.js}"
    },
    "api/academy-mcp.js": {
      "maxDuration": 30,
      "includeFiles": "{academy/edges.mjs,academy/data/**,ml/models/index.json,assets/academy-core.js}"
    }
  }
}
