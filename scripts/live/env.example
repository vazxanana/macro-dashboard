# MeridianX live runner: copy to %USERPROFILE%\meridianx\.env (Windows) or ~/meridianx/.env (Linux). Names only here; put the
# values in your copy. Never commit this file with values.
GH_TOKEN=            # fine-grained GitHub token, this repository only, Contents: read and write (pushes council-data)
OANDA_TOKEN=         # optional: OANDA practice API token -> candles from a local proxy, no Vercel function calls
OANDA_ENV=practice
CTRADER_MIRROR=on
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_ENV=demo
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LIVE_EVERY=30
LIVE_PUSH_EVERY=300
